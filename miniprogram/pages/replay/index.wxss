.small { font-size: 44rpx; }
.mode-row { display: flex; gap: 28rpx; color: #41544a; }
.progress-wrap { margin: 24rpx 0; }
.progress { height: 10rpx; margin-top: 14rpx; border-radius: 99rpx; background: #dfe6e1; overflow: hidden; }
.progress-bar { height: 100%; background: #207854; transition: width .2s; }
.decision-title { margin: 28rpx 0 18rpx; font-size: 34rpx; font-weight: 650; }
.decision-input { font-size: 36rpx; font-weight: 650; }
.preview { margin-top: 20rpx; padding: 20rpx; border-radius: 16rpx; background: #f0f6f2; }
.account-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0 28rpx; margin-top: 10rpx; }
.finish { margin-top: 30rpx; padding: 36rpx 30rpx; border-radius: 28rpx; background: #1c3127; color: #f5faf7; }
.finish-title { margin-top: 14rpx; font-size: 38rpx; line-height: 1.45; font-weight: 650; }
.finish .card { color: #17211c; }
.mini { font-size: 29rpx; }
.rank-row { display: flex; justify-content: space-between; padding: 18rpx 0; border-bottom: 1rpx solid #edf0ee; }
